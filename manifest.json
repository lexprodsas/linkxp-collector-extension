{
  "manifest_version": 3,
  "name": "LinkXP - LinkedIn stats collector",
  "version": "1.0.0",
  "description": "Collecte automatique des statistiques LinkedIn pour LinkXP",

  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms"
  ],

  "host_permissions": [
    "https://*.linkedin.com/*",
    "https://app.linkxp.net/*"
  ],

  "web_accessible_resources": [
    {
      "resources": ["api-auth.js"],
      "matches": ["<all_urls>"]
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://*.linkedin.com/*"],
      "js": ["content.js"],
      "css": ["content-styles.css"],
      "run_at": "document_idle"
    }
  ],

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
