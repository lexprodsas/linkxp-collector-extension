{
  "manifest_version": 3,
  "name": "LinkXP - LinkedIn stats collector",
  "version": "1.1.0",
  "description": "Collecte automatique des statistiques LinkedIn pour LinkXP",

  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],

  "host_permissions": [
    "https://*.linkedin.com/*",
    "https://app.linkxp.net/*"
  ],

  "externally_connectable": {
    "matches": ["https://app.linkxp.net/*"]
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "background": {
    "service_worker": "background.js"
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
